							"path": ["refreshToken"]
						},
						"description": "使用刷新令牌换取新的 access token。"
					}
				},
				{
					"name": "无Token访问(应401)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// 故意移除鉴权头，验证未授权访问被拦截",
									"pm.request.headers.remove('Authorization');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('未携带Token应返回401', function () {",
									"    var code = pm.response.json().code || 0;",
									"    pm.expect([401, 403]).to.include(code).or.to.include(pm.response.code);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/system/user/list?pageNum=1&pageSize=10",
							"host": ["{{base_url}}"],
							"path": ["system", "user", "list"],
							"query": [
								{"key": "pageNum", "value": "1"},
								{"key": "pageSize", "value": "10"}
							]
						},
						"description": "不携带 Token 访问受保护接口，预期返回 401 未授权。"
					}
				}
			]
		},
