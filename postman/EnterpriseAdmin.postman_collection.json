{
	"info": {
		"_postman_id": "a1b2c3d4-0001-4a00-9f00-enterprise01",
		"name": "EnterpriseAdmin 接口测试集合",
		"description": "EnterpriseAdmin 企业级后台管理系统接口测试集合。\n\n- 鉴权方式：Bearer Token（JWT）\n- 环境变量：{{base_url}}、{{token}}、{{username}}、{{password}}\n- 登录接口 Tests 脚本会自动提取 token 并写入环境变量，后续请求通过 Pre-request Script 自动注入 Authorization 头。\n- 每个请求均含状态码与业务码断言。",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "username",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "password",
			"value": "Admin@123",
			"type": "string"
		},
		{
			"key": "uuid",
			"value": "test-uuid-0001",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "2",
			"type": "string"
		},
		{
			"key": "roleId",
			"value": "3",
			"type": "string"
		},
		{
			"key": "jobId",
			"value": "1",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 集合级 Pre-request 脚本：自动为需要鉴权的请求注入 Token",
					"// 排除登录类无鉴权接口",
					"var noAuthPaths = ['/login', '/captchaImage', '/refreshToken'];",
					"var url = pm.request.url.toString();",
					"var needAuth = true;",
					"for (var i = 0; i < noAuthPaths.length; i++) {",
					"    if (url.indexOf(noAuthPaths[i]) > -1) { needAuth = false; break; }",
					"}",
					"if (needAuth) {",
					"    var token = pm.collectionVariables.get('token') || '';",
					"    if (!token) { token = pm.environment.get('token') || ''; }",
					"    if (token) {",
					"        pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + token});",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// 集合级通用断言：HTTP 状态码为 200",
					"pm.test('HTTP 状态码为 200', function () {",
					"    pm.response.to.have.status(200);",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "01-登录认证",
			"description": "登录认证相关接口：登录、获取用户信息、退出、刷新令牌。",
			"item": [
				{
					"name": "用户登录",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test('HTTP 状态码为 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('业务码 code 为 200', function () {",
									"    pm.expect(jsonData.code).to.eql(200);",
									"});",
									"pm.test('返回 token 非空', function () {",
									"    var token = jsonData.token || (jsonData.data && jsonData.data.token);",
									"    pm.expect(token).to.not.be.empty;",
									"});",
									"// 自动提取并保存 token，供后续请求使用",
									"var token = jsonData.token || (jsonData.data && jsonData.data.token);",
									"if (token) {",
									"    pm.collectionVariables.set('token', token);",
									"    pm.environment.set('token', token);",
									"    console.log('Token 已保存到环境变量');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"code\": \"1234\",\n    \"uuid\": \"{{uuid}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "账号密码登录，成功后返回 JWT Token。Tests 脚本自动将 token 写入环境变量。"
					}
				},
