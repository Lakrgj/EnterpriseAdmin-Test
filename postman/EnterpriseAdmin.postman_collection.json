							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test('HTTP 状态码为 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('刷新令牌成功或返回明确错误', function () {",
									"    pm.expect([200, 500]).to.include(jsonData.code);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/refreshToken",
